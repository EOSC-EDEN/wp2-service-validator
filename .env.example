# ──────────────────────────────────────────────────────────────────────────────
# EDEN Service Validator — environment variables
#
# Copy this file to .env and fill in the values for your deployment.
# Never commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Fuseki / SPARQL store ─────────────────────────────────────────────────────
# Credentials for the Fuseki SPARQL endpoint used by batch_validator.py.
# Leave blank if your Fuseki instance does not require authentication.
FUSEKI_USERNAME=fuseki
FUSEKI_PASSWORD=fuseki_123

# ── wp2-service-identifier ────────────────────────────────────────────────────
# Base URL of the wp2-service-identifier service.
# The validator appends /identify to this URL when auto-inferring the service type.
IDENTIFIER_BASE_URL=http://localhost:8001

# Minimum confidence score (0.0–10.0) from the identifier required to auto-proceed
# without prompting in CLI mode.  Scores below this threshold trigger an interactive
# confirmation step.  API and batch modes always auto-proceed regardless of this value.
IDENTIFIER_CONFIDENCE_THRESHOLD=5.0
