# Read by uvicorn itself. The entry VM reaches this VM over eden-net, so bind
# this VM's private IP: loopback is unreachable from there, and 0.0.0.0 would
# listen on every interface. The harvester already uses 8000 on this VM, and
# the eden-service security group needs TCP 8002 from eden-entry added.
UVICORN_HOST=192.168.0.x
UVICORN_PORT=8002

# The entry VM's private IP. uvicorn only believes X-Forwarded-Proto from the
# addresses listed here; without it, the app's own redirects point at http://.
UVICORN_FORWARDED_ALLOW_IPS=192.168.0.111

# Lets the page and /validate check hosts on private networks. Leave unset on
# the EU node: there it would let anyone probe the harvester, Fuseki and the
# entry VM.
# EDEN_ALLOW_PRIVATE_TARGETS=
